# =============================================================================
# Docker 构建上下文排除清单（后端 + 前端共用，构建上下文 = 项目根）
# 目的：镜像里只保留源码与依赖清单，本机运行时数据 / 密钥 / 构建产物一律不进
# =============================================================================

# ── 版本控制与本地环境 ────────────────────────────────────────────────────────
.git
.gitignore
.dockerignore

# ── 密钥（绝对不进镜像）──────────────────────────────────────────────────────
# 顶层 + 任意子目录都排除（例：frontend/.env 若被带入构建，
# Vite 会把 VITE_API_BASE_URL=http://localhost:8000 烤进产物，绕过 nginx 反代）
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# ── 依赖与构建产物（镜像内重新安装 / 重新构建）────────────────────────────────
frontend/node_modules
frontend/dist
**/__pycache__
**/*.py[cod]
**/*.egg-info

# ── 本机运行时数据（体积大且不该进镜像）──────────────────────────────────────
.tools
uploads
backend/models

# ── 文档与编辑器 ──────────────────────────────────────────────────────────────
.vscode
.idea
.DS_Store
*.code-workspace
DOCKER.md
README.md
