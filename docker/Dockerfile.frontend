# =============================================================================
# 出海 AI 短视频审核平台 · 前端镜像
# 多阶段构建：Node 编译 Vue 静态资源 → Nginx 托管 + 反向代理 /api
# 构建上下文 = 项目根目录
#   docker build -f docker/Dockerfile.frontend -t eduagent-frontend .
# =============================================================================

# ── 阶段 1：编译 ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

# 先拷 lockfile 单独装依赖，源码改动可复用这层缓存
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# 再拷源码并构建（package.json 的 build = vue-tsc && vite build）
COPY frontend/ ./
RUN npm run build


# ── 阶段 2：托管 ──────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# 静态资源
COPY --from=build /app/dist /usr/share/nginx/html

# 站点配置：SPA 回退 + /api 反向代理到 backend 容器
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
