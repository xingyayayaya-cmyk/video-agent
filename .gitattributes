# =============================================================================
# 统一换行符，保证 Windows / macOS / Linux 三端 clone 下来行为一致
#   - 源码统一以 LF 存入仓库（Mac/Linux/Docker 直接用）
#   - Windows 批处理必须 CRLF，否则 cmd.exe 解析可能出错
# =============================================================================

* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.webp binary
*.woff binary
*.woff2 binary
