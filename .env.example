# =============================================================================
# 出海 AI 短视频审核平台 · 环境变量模板
# -----------------------------------------------------------------------------
# 用法：cp .env.example .env  然后填入真实密钥。
# .env 已在 .gitignore 中，不会进入版本库。
#
# 注意：用 docker compose 启动时，DB_HOST/DB_PORT/FFMPEG_PATH 等
#       会被 docker-compose.yml 的 environment 段自动覆盖为容器内正确值，
#       这里保持本机开发默认值即可，不必改。
# =============================================================================

# ===== 应用基础配置 =====
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default

# ===== 数据库（PostgreSQL）=====
# 宿主映射端口 5433（容器内是 5432），避免与本机已装的 PG 冲突
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduagent
DB_USER=eduagent_user
DB_PASSWORD=change-me-please

# ===== 大模型 API =====
# DeepSeek：聚合轨（六维度风险评估）+ 区域轨（区域合规复核）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_CODER=deepseek-coder

# Kimi：视觉轨 / 元数据轨（sk-kimi- 前缀套餐 key 走 coding 端点）
# 端点约束：temperature 必须 = 1（代码已强制）
KIMI_API_KEY=sk-your-kimi-api-key
KIMI_BASE_URL=https://api.kimi.com/coding/v1

# OpenAI：视觉/文本轨已改接 Kimi，此项保留兼容（可留空）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_VISION=gpt-4o
OPENAI_MODEL_TEXT=gpt-4o

# ===== ASR 云端 API（音频转文字）=====
# 当前走阿里百炼 qwen3-omni 全模态模型（chat/completions + input_audio）
ASR_PROVIDER=dashscope
ASR_API_KEY=sk-your-dashscope-api-key
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen3-omni-flash
ASR_LANGUAGE=zh

# ===== 视频处理（ffmpeg）=====
# 容器内为 apt 安装，保持默认值即可（compose 会自动覆盖）
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_FRAME_INTERVAL=5.0
VIDEO_CLIP_INTERVAL=2.0
VIDEO_MAX_FRAMES=30
VIDEO_MAX_DURATION=600
VIDEO_SCENE_THRESHOLD=0.35

# ===== 出海区域审核配置 =====
REVIEW_REGIONS=US,EU,LATAM,MENA,SEA
REVIEW_DEFAULT_REGION=US
REVIEW_AUTO_APPROVE_THRESHOLD=0.85
REVIEW_AUTO_REJECT_THRESHOLD=0.30
REVIEW_CONFIDENCE_THRESHOLD=0.7

# ===== LangGraph Checkpointer（人工复核状态持久化）=====
# sqlite  ：默认，跨平台无依赖
# postgres：Linux 生产可选（需镜像内可用 psycopg + libpq）
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=./.tools/checkpoints.db

# ===== JWT 认证 =====
# 生产环境务必换成随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
